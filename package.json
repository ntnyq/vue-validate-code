{
  "name": "vue-validate-code",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@12.5.1",
  "description": "Vue validate code",
  "keywords": [
    "validate",
    "validate-code",
    "vue",
    "vue-component",
    "vue-plugin"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com",
    "url": "https://ntnyq.com"
  },
  "homepage": "https://github.com/ntnyq/vue-validate-code",
  "repository": "ntnyq/vue-validate-code",
  "bugs": {
    "url": "https://github.com/ntnyq/vue-validate-code/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./volar": {
      "types": "./types/volar.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "deploy": "run-s build docs:build",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint",
    "prepack": "pnpm run build",
    "prepare": "husky",
    "release": "run-s release:check release:version",
    "release:check": "run-p lint typecheck test",
    "release:version": "bumpp",
    "test": "vitest",
    "test:browser": "vitest --ui --browser --config=vitest.browser.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.20",
    "@ntnyq/utils": "^0.23.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.68.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "unplugin-vue": "^7.2.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vitest-browser-vue": "^3.1.0",
    "vitest-canvas-mock": "^1.2.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "nano-staged": {
    "*.{js,ts,cjs,mjs,tsx,vue,md,yml,yaml,json}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
